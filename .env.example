# ===== Discord =====
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ===== User Identity =====
# Your identifier for the memory system (single-user)
BOT_USER_ID=user
# The AI companion's display name (used in diary, prompts, etc.)
BOT_NAME=Aura
# Optional: a special person the AI should track closely (e.g. partner name)
SPECIAL_PERSON_NAME=
SPECIAL_PERSON_LABEL=Special Person

# ===== Model Access =====
# Recommended: enable Antigravity proxy for Opus/Gemini
ANTIGRAVITY_PROXY_ENABLED=true
ANTIGRAVITY_PROXY_URL=http://localhost:8080

# Optional direct API keys (only needed when proxy disabled)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=your_gemini_key_here

# ===== Default Model =====
# Recommended for best experience
DEFAULT_MODEL=anthropic/claude-opus-4-6-thinking

# ===== Memory + Context Tuning =====
# Retrieval count from vector DB per message
MEMORY_RETRIEVAL_LIMIT=120
MEMORY_EXTRACTION_CONTEXT_TURNS=8
MEMORY_EXTRACTION_CONTEXT_MAX_CHARS=2200
DETAIL_CONTEXT_HINT_TURNS=3
DETAIL_CONTEXT_HINT_MAX_CHARS=220

# Approx token budgets used by ContextBuilder
MEMORY_TOKEN_BUDGET=18000
HISTORY_TOKEN_BUDGET=120000
SYSTEM_PROMPT_TOKEN_BUDGET=30000
TOTAL_CONTEXT_TOKEN_BUDGET=160000
RESPONSE_RESERVE_TOKENS=8192
MAX_OUTPUT_TOKENS=4096
MAX_HISTORY_TURNS=2000
LONG_MESSAGE_THRESHOLD=80000
LONG_MESSAGE_KEEP_CHARS=8000
USER_TIMEZONE=America/Los_Angeles
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SEC=8
ARCHIVE_SEARCH_ENABLED=true
ARCHIVE_SEARCH_MAX_RESULTS=4
ARCHIVE_SEARCH_MAX_SCAN_EVENTS=25000
ARCHIVE_CONTEXT_MAX_CHARS=1200
ARCHIVE_ROLLUP_ENABLED=true
ARCHIVE_ROLLUP_EVERY_N_TURNS=12
ARCHIVE_ROLLUP_MIN_MESSAGES=80
ARCHIVE_ROLLUP_MIN_DELTA=40
ARCHIVE_ROLLUP_SCAN_LIMIT=250000
ARCHIVE_DAILY_ROLLUP_MIN_MESSAGES=24
ARCHIVE_DAILY_ROLLUP_MIN_DELTA=12
ARCHIVE_WEEKLY_ROLLUP_MIN_MESSAGES=48
ARCHIVE_WEEKLY_ROLLUP_MIN_DELTA=24
SCOPED_MEMORY_ENABLED=true
SCOPED_MEMORY_MAX_CHARS=1600
SCOPED_MEMORY_SESSION_LINES=4
SCOPED_MEMORY_DAILY_LINES=4
SCOPED_MEMORY_WEEKLY_LINES=5
SCOPED_MEMORY_MONTHLY_LINES=6
SCOPED_MEMORY_CACHE_TTL_SEC=120
SCOPED_SCORE_RELEVANCE_WEIGHT=0.55
SCOPED_SCORE_IMPORTANCE_WEIGHT=0.20
SCOPED_SCORE_OVERLAP_WEIGHT=0.15
SCOPED_SCORE_RECENCY_WEIGHT=0.10
AUTO_DETAIL_CLEANUP_ENABLED=true
AUTO_DETAIL_CLEANUP_EVERY_N_TURNS=60
AUTO_DETAIL_CLEANUP_MAX_DELETE=30
VOICE_AUTO_TRANSCRIBE=true
VOICE_TRANSCRIBE_MODEL=anthropic/claude-opus-4-6-thinking
VOICE_TRANSCRIBE_MAX_FILE_SIZE=15000000
VOICE_TRANSCRIBE_MAX_TOKENS=3000

# Soul auto-summary refresh frequency
SOUL_SYNC_EVERY_N_ADDS=6
SOUL_SYNC_MIN_INTERVAL_SEC=90
SOUL_SYNC_MAX_MEMORIES=6000
SOUL_PROMPT_MAX_CHARS=12000
SOUL_SUMMARY_MAX_ITEMS=4
SOUL_KEY_MEMORY_MAX_ITEMS=8
SOUL_TOTAL_SUMMARY_MAX=24
SOUL_OVERVIEW_MAX_PER_SECTION=3
SOUL_OVERVIEW_TEXT_MAX_CHARS=68
SOUL_OVERVIEW_MAX_KEYWORDS=4
SOUL_BACKUP_KEEP=20
ALLOW_LLM_SOUL_EDIT=false
ALLOW_EMPTY_SOUL_SUMMARY_SYNC=false

# Startup self-healing if vector DB looks unexpectedly empty
AUTO_RECOVER_MEMORY_ON_START=true
AUTO_RECOVER_MIN_COUNT=5
RECOVER_INCLUDE_DETAILS=false

# Raw detail chunking / dedupe
DETAIL_MIN_CHARS=4
DETAIL_CHUNK_CHARS=260
DETAIL_MAX_CHUNKS_PER_TURN=24
MEMORY_GET_ALL_PAGE_SIZE=500
MEMORY_DUPLICATE_SCORE=0.92
MEMORY_DETAIL_EXPANSION_ENABLED=true
MEMORY_DETAIL_EXPANSION_ANCHORS=6
MEMORY_DETAIL_EXPANSION_PER_ANCHOR=3
MEMORY_DETAIL_EXPANSION_QUERY_LIMIT=14
MEMORY_DETAIL_EXPANSION_MAX=28
MEMORY_DETAIL_EXPANSION_MIN_SCORE=0.55
MEM0_INFER=false
AUTO_REPAIR_ON_INDEX_ERROR=true
RECOVER_MAX_ITEMS=800
CHROMA_BACKUP_KEEP=8

# ===== Diary Feature =====
DIARY_ENABLED=true
DIARY_AUTO_GENERATE=true
DIARY_AUTO_GENERATE_AFTER_MESSAGES=30
DIARY_AUTO_GENERATE_TIME=23:30
DIARY_MODEL=anthropic/claude-opus-4-6-thinking
DIARY_MAX_TOKENS=4096
DIARY_VIEWER_PORT=8888
